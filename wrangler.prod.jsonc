// Cloudflare Workers config for examanet-prod (production)
// Used for DNS swap from Vercel to Cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker-with-cache.js",
  "name": "examanet-prod",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // 2026-09-07: DNS swap complete. examanet.com + www → CF Worker (D1).
  // Vercel still serves as a fallback (any cached routes might still hit
  // Vercel CDN until the Vercel deploy is shut down in Phase 9).
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://examanet.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "examanet-prod"
    }
  ],
  "observability": {
    "enabled": true
  },
  // PERF 2026-09-02 (Step 4): Cron trigger for performance monitoring
  // Calls /api/cron/monitor-alerts every 5 minutes
  // 2026-09-05: Added 0 3 * * * for nightly cleanup (cleanup-views + nightly-cleanup)
  // 2026-09-07: DNS swap - custom domains added via API
  // (CF API token lacks Workers Routes:Edit scope)
  // wrangler deploy will keep this config valid; custom domains are
  // managed separately via /accounts/{id}/workers/domains
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "examanet-pdf-prod"
    },
    {
      "binding": "PDFS_BUCKET",
      "bucket_name": "examanet-pdf-prod"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0efd509743664a878558982376fb965e"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "c71ef22c749349b0a68266c3f2ecb6b4"
    },
    {
      "binding": "APP_CACHE",
      "id": "b06e8c86184c45b690594f5fd7aa524f"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "examanet-db",
      "database_id": "22ad2e7f-1692-486e-9131-d6c4062012e1",
      "migrations_dir": "drizzle-migrations"
    }
  ]
}
