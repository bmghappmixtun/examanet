// Cloudflare Workers config for examanet-prod (production)
// Used for DNS swap from Vercel to Cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker-with-cache.js",
  "name": "examanet-prod",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // 2026-09-05: Force emails/links to point to the Worker URL while examanet.com
  // is still on Vercel. Without this, NEXT_PUBLIC_SITE_URL falls back to
  // "https://examanet.com" → emails redirect to Vercel → Vercel queries old
  // Neon DB → invitation not found (data lives in D1 now).
  // Switch back to "https://examanet.com" after DNS swap is done.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://examanet-prod.examanet-poc.workers.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "examanet-prod"
    }
  ],
  "observability": {
    "enabled": true
  },
  // PERF 2026-09-02 (Step 4): Cron trigger for performance monitoring
  // Calls /api/cron/monitor-alerts every 5 minutes
  // 2026-09-05: Added 0 3 * * * for nightly cleanup (cleanup-views + nightly-cleanup)
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "examanet-pdf-prod"
    },
    {
      "binding": "PDFS_BUCKET",
      "bucket_name": "examanet-pdf-prod"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0efd509743664a878558982376fb965e"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "c71ef22c749349b0a68266c3f2ecb6b4"
    },
    {
      "binding": "APP_CACHE",
      "id": "b06e8c86184c45b690594f5fd7aa524f"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "examanet-db",
      "database_id": "***REMOVED***",
      "migrations_dir": "drizzle-migrations"
    }
  ]
}
