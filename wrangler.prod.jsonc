// Cloudflare Workers config for examanet-prod (production)
// Used for DNS swap from Vercel to Cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker-with-cache.js",
  "name": "examanet-prod",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "examanet-prod"
    }
  ],
  "observability": {
    "enabled": true
  },
  // NOTE: cron trigger removed. The /api/cron/agent-poll route was designed
  // for Vercel Cron (uses prisma) and currently has no CF-native scheduled
  // handler. Re-add a "triggers.crons" entry when a CF scheduled handler is
  // implemented (opennext 1.20+ supports default.scheduled override).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "examanet-pdf-prod"
    },
    {
      "binding": "PDFS_BUCKET",
      "bucket_name": "examanet-pdf-prod"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0efd509743664a878558982376fb965e"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "c71ef22c749349b0a68266c3f2ecb6b4"
    },
    {
      "binding": "APP_CACHE",
      "id": "b06e8c86184c45b690594f5fd7aa524f"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f229c4a38255449198890e4259aef52e"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "examanet-db",
      "database_id": "22ad2e7f-1692-486e-9131-d6c4062012e1",
      "migrations_dir": "drizzle-migrations"
    }
  ]
}
